{
  "name": "publish",
  "description": "Checks a ticket, publishes it (an outside effect, done once), and notes where.",
  "states": ["draft", "checked", "published"],
  "start": "draft",
  "end": ["published"],
  "transitions": [
    { "from": "draft", "on": "lifecycle.attached", "to": "checked",
      "description": "A title is needed to publish.",
      "do": [ { "action": "steps.check@1", "expect": "output.ok" } ] },
    { "from": "checked", "to": "published",
      "description": "Runs by itself once the ticket is checked.",
      "do": [
        { "action": "steps.publish@1" },
        { "action": "ticket.update@1", "with": { "note": "Published as ${prev.published}." } }
      ] }
  ]
}
