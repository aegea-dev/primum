{
  "name": "hello",
  "description": "Waits for a reply, sent over HTTP or as a file in inbox/; a minute without one makes it late.",
  "states": ["waiting", "answered", "late"],
  "start": "waiting",
  "end": ["answered", "late"],
  "transitions": [
    { "from": "waiting", "on": "input.received", "to": "answered",
      "timeout": "1m", "on_timeout": "late",
      "do": [ { "action": "ticket.update@1", "with": { "note": "Answered." } } ] }
  ]
}
